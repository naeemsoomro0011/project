PORT=5000
NODE_ENV=production

# MongoDB Atlas connection string
MONGO_URI=

# JWT
JWT_SECRET=
JWT_EXPIRES_IN=

# Super Admin seed credentials (used once on first server start, if no Super Admin exists yet)
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
SUPERADMIN_PHONE=
SUPERADMIN_NAME=

# Set to false in production
DEV_EXPOSE_OTP=false

# Base URL the frontend uses to reach this API
BASE_URL=

# --- Email (Gmail SMTP) ---
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM_NAME=

# --- Cloudinary (image uploads) ---
# Free account: https://cloudinary.com -> Console -> Account Details
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
